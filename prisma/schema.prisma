model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  resumeName     String
  basics         Json     @default("[]")
  summary        Json     @default("[]")
  profiles       Json     @default("[]")
  skills         Json     @default("[]")
  projects       Json     @default("[]")
  education      Json     @default("[]")
  experience     Json     @default("[]")
  languages      Json     @default("[]")
  volunteer      Json     @default("[]")
  awards         Json     @default("[]")
  publications   Json     @default("[]")
  certifications Json     @default("[]")
  references     Json     @default("[]")
  custom         Json     @default("{}")
  styles         Json     @default("{}")
  createdOn      DateTime @default(now()) // Automatically set when a record is created
  updatedOn      DateTime @updatedAt // Automatically updated whenever the record is updated

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resume")
}

model Coverletter {
  id                  String   @id @default(cuid())
  userId              String
  coverName           String
  salutation          String   @default("")
  date                String   @default("")
  senderInfo          String   @default("")
  recipientInfo       String   @default("")
  subject             String   @default("")
  opening             String   @default("")
  interestInPosition  String   @default("")
  professionalSummary String   @default("")
  keyAchievements     String   @default("")
  culturalFit         String   @default("")
  closing             String   @default("")
  signOff             String   @default("")
  styles              Json     @default("{}")
  createdOn           DateTime @default(now()) // Automatically set when a record is created
  updatedOn           DateTime @updatedAt // Automatically updated whenever the record is updated

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coverletter")
}

model Blog {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String? // Optional, for SEO/meta description
  content    String
  category   String
  thumbnail  String
  author     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  published  Boolean  @default(false) // To handle drafts
  tags       String[] // For SEO and content categorization
  spark      Int      @default(0) // Optional, tracking popularity or rating
  views      Int      @default(0) // Optional, track the number of views
  isFeatured Boolean  @default(false)

  @@map("blog")
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  basics         Json     @default("[]")
  summary        Json     @default("[]")
  profiles       Json     @default("[]")
  skills         Json     @default("[]")
  projects       Json     @default("[]")
  education      Json     @default("[]")
  experience     Json     @default("[]")
  languages      Json     @default("[]")
  volunteer      Json     @default("[]")
  awards         Json     @default("[]")
  publications   Json     @default("[]")
  certifications Json     @default("[]")
  references     Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("profile")
}

model Payment {
  id          String   @id @default(cuid()) // Payment record ID
  paymentId   String   @unique // Unique transaction identifier
  userId      String // Foreign key to User
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String // Identifier for purchased item
  productName String // Name of the purchased item
  quantity    Int // Quantity of the purchased item
  total       Decimal  @db.Decimal(10, 2) // Total payment amount
  tax         Decimal  @db.Decimal(10, 2) // Tax amount
  currency    String // Currency code (e.g., "INR")
  status      String // Enum for payment status
  credits     Int
  createdAt   DateTime @default(now()) // Payment initiation timestamp
  updatedAt   DateTime @updatedAt // Last updated timestamp

  @@map("payment")
}

model UserAssets {
  id         String   @id @default(cuid()) // Payment record ID
  userId     String   @unique
  credits    Int      @default(0) // Credits left for the user
  resumeslot Int      @default(1) // Number of slots for storing resumes
  coverslot  Int      @default(1)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("userassets")
}

model Tokens {
  id           String @id @default(cuid())
  accessToken  String
  refreshToken String
  userId       String @unique
  email        String @unique
  expires      BigInt
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobEmails {
  id          String   @id @default(cuid())
  jobId       String
  jobState    String   
  jobRole     String
  companyName String
  location    String
  workType    String
  description String
  meetingUrl  String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserJobs")
  createdAt   DateTime @default(now())

  @@unique([jobId, userId])
}

model JD {
  id             String @id @default(cuid())
  userId         String 
  companyName    String
  employmentType String
  r2FileName     String @unique()
  jobTitle       String
  location       String
  logoSrc        String
  salaryRange    String
  source         String
  state          String
  url            String
  workType       String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
