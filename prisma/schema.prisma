generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  name        String?
  email       String        @unique
  image       String?
  provider    String        @default("")
  isOnboarded Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  CoverLetter Coverletter[]
  Payment     Payment[]
  Profile     Profile?
  Resume      Resume[]
  UserAssests UserAssets?
  Token       Tokens?
  jobEmails   JobEmails[]   @relation("UserJobs")
  JDs         JD[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  resumeName     String
  basics         Json     @default("[]")
  summary        Json     @default("[]")
  profiles       Json     @default("[]")
  skills         Json     @default("[]")
  projects       Json     @default("[]")
  education      Json     @default("[]")
  experience     Json     @default("[]")
  languages      Json     @default("[]")
  volunteer      Json     @default("[]")
  awards         Json     @default("[]")
  publications   Json     @default("[]")
  certifications Json     @default("[]")
  references     Json     @default("[]")
  custom         Json     @default("{}")
  styles         Json     @default("{}")
  createdOn      DateTime @default(now())
  updatedOn      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resume")
}

model Coverletter {
  id                  String   @id @default(cuid())
  userId              String
  coverName           String
  salutation          String   @default("")
  date                String   @default("")
  senderInfo          String   @default("")
  recipientInfo       String   @default("")
  subject             String   @default("")
  opening             String   @default("")
  interestInPosition  String   @default("")
  professionalSummary String   @default("")
  keyAchievements     String   @default("")
  culturalFit         String   @default("")
  closing             String   @default("")
  signOff             String   @default("")
  styles              Json     @default("{}")
  createdOn           DateTime @default(now())
  updatedOn           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coverletter")
}

model Blog {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  category   String
  thumbnail  String
  author     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  published  Boolean  @default(false)
  tags       String[]
  spark      Int      @default(0)
  views      Int      @default(0)
  isFeatured Boolean  @default(false)

  @@map("blog")
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  basics         Json     @default("[]")
  summary        Json     @default("[]")
  profiles       Json     @default("[]")
  skills         Json     @default("[]")
  projects       Json     @default("[]")
  education      Json     @default("[]")
  experience     Json     @default("[]")
  languages      Json     @default("[]")
  volunteer      Json     @default("[]")
  awards         Json     @default("[]")
  publications   Json     @default("[]")
  certifications Json     @default("[]")
  references     Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile")
}

model Payment {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  userId      String
  productId   String
  productName String
  quantity    Int
  total       Decimal  @db.Decimal(10, 2)
  tax         Decimal  @db.Decimal(10, 2)
  currency    String
  status      String
  credits     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model UserAssets {
  id         String   @id @default(cuid())
  userId     String   @unique
  credits    Int      @default(0)
  resumeslot Int      @default(1)
  coverslot  Int      @default(1)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("userassets")
}

model Tokens {
  id           String @id @default(cuid())
  accessToken  String
  refreshToken String
  userId       String @unique
  email        String @unique
  expires      BigInt
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobEmails {
  id          String   @id @default(cuid())
  jobId       String
  jobState    String
  jobRole     String
  companyName String
  location    String
  workType    String
  description String
  meetingUrl  String
  userId      String
  isDeleted   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserJobs")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([jobId, userId])
}

model JD {
  id             String   @id @default(cuid())
  userId         String
  companyName    String
  employmentType String
  r2FileName     String   @unique()
  jobTitle       String
  location       String
  logoSrc        String
  salaryRange    String
  source         String
  state          String
  url            String
  workType       String
  addedOn        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  isDeleted      Boolean  @default(false)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
